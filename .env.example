# Copy to .env and edit. Every setting is optional; the defaults below are what you get with no .env at all.
# Real environment variables override this file. Docker Compose reads the same file.

# ---------------------------------------------------------------- Docker Compose only
# Which image to run with `docker compose up -d`: cpu | gpu | npu
COMPOSE_PROFILES=cpu

# ---------------------------------------------------------------- server
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network (Docker always uses 0.0.0.0 inside)
HOST=127.0.0.1
PORT=7860
LOG_LEVEL=info
# Require this key on every /api/v1 call except health/ready/info (header "X-API-Key: <key>" or "Authorization: Bearer <key>").
# Empty = no authentication. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Allow browser apps on other origins to call the API, comma separated, or * for any. Empty = same origin only.
CORS_ORIGINS=
# Serve the web UI at / (false = API only)
ENABLE_UI=true

# ---------------------------------------------------------------- hardware
# auto = best available: Rockchip NPU -> NVIDIA GPU (CUDA) -> Apple GPU (MPS) -> CPU
# or force one: rknn | cuda | mps | cpu | onnx
DIAR_BACKEND=auto
# If the chosen backend fails at startup, fall back to the CPU instead of refusing to start
DIAR_FALLBACK=true
# CPU threads for PyTorch; 0 = all physical cores
CPU_THREADS=0
# Which NVIDIA GPU to use when there are several
CUDA_DEVICE=0
# Rockchip only: NPU core mask (all | auto | 0 | 1 | 2 | 0_1 | 0_1_2) and SoC override if detection fails
NPU_CORE_MASK=all
# RK_PLATFORM=rk3576

# ---------------------------------------------------------------- model
# Hugging Face model id, or a local directory containing the downloaded model (offline installs)
MODEL_ID=nvidia/Nemotron-3-Diarization
# Set to 1 once the model is downloaded to never contact the Hugging Face Hub
# HF_HUB_OFFLINE=1
# Where models are cached (default: ~/.cache/huggingface)
# HF_HOME=/data/hf

# ---------------------------------------------------------------- limits and defaults
# Largest upload accepted (MB)
MAX_UPLOAD_MB=2048
# Longest audio accepted (minutes); 0 = unlimited. ~4 MB of RAM per minute of audio.
MAX_AUDIO_MINUTES=0
# Pending /api/v1/jobs before new ones get HTTP 429
MAX_QUEUED_JOBS=100
# Finished jobs and their results are kept this long
JOB_TTL_MINUTES=60
# Defaults for the segmentation parameters (each request can override them)
DEFAULT_THRESHOLD=0.5
DEFAULT_MIN_SEGMENT=0.1
DEFAULT_MERGE_GAP=0.3
