# syntax=docker/dockerfile:1
# Nemotron-3-Diarization server for Rockchip NPUs (RK3566 / RK3568 / RK3576 / RK3588), linux/arm64.
# Prebuilt image: ghcr.io/anand34577/nemotron-diarization:rknn (see docs/DOCKER.md).
#
#   python3 scripts/download_models.py all      # the .rknn models must be in rknn_models/ before building
#   docker build -f Dockerfile.rknn -t nemotron-diarization:rknn .
#
# Rockchip's NPU runtime is NOT in the image (proprietary RKNN SDK License). With RKNN_ACCEPT_LICENSE=yes the
# entrypoint downloads it from Rockchip on first start into /opt/rknn. Without it, or without a working NPU driver,
# the server runs on the board's CPU.
FROM python:3.11-slim-bookworm

LABEL org.opencontainers.image.title="Nemotron Diarization (Rockchip NPU)" \
      org.opencontainers.image.description="Speaker diarization API and web UI on RK3566/RK3568/RK3576/RK3588 NPUs. Rockchip runtime downloaded on first start after license acceptance. Third-party licenses in /licenses." \
      org.opencontainers.image.source="https://github.com/anand34577/nemotron-diarization" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HOST=0.0.0.0 \
    PORT=7860 \
    DIAR_BACKEND=auto \
    NPU_CORE_MASK=all \
    RKNN_ACCEPT_LICENSE=no \
    LD_LIBRARY_PATH=/opt/rknn/lib \
    PYTHONPATH=/opt/rknn/python

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch: on the board it only runs the light pre/post-processing and the speaker cache.
# >= 2.7 is required: with CPU-only torch 2.6, transformers 5.19 fails on import (torch.accelerator raises)
RUN pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu
COPY requirements-rknn.txt /tmp/requirements-rknn.txt
RUN pip install -r /tmp/requirements-rknn.txt

# config, processor and weights of the CPU-side parts (feature stacking, speaker cache), baked into the image;
# the model card is kept as the model's notice of origin
RUN python - <<'EOF'
import os, shutil
from huggingface_hub import snapshot_download
path = snapshot_download("nvidia/Nemotron-3-Diarization", allow_patterns=["*.json", "model.safetensors", "README.md"])
os.makedirs("/licenses", exist_ok=True)
shutil.copy(os.path.join(path, "README.md"), "/licenses/Nemotron-3-Diarization-MODEL_CARD.md")
EOF
ENV HF_HUB_OFFLINE=1

RUN python -m venv /tmp/pl && /tmp/pl/bin/pip install -q pip-licenses \
 && /tmp/pl/bin/pip-licenses --python /usr/local/bin/python --from=mixed --with-urls --with-license-file \
      --no-license-path --format=plain-vertical > /licenses/python-packages.txt \
 && rm -rf /tmp/pl \
 && dpkg-query -W -f='${Package} ${Version}\n' > /licenses/debian-packages.txt
COPY --chmod=644 LICENSE NOTICE THIRD_PARTY_NOTICES.md licenses/OpenMDW-1.1.txt /licenses/

RUN mkdir -p /opt/rknn/lib /opt/rknn/python
WORKDIR /app
COPY app.py diar_engine.py settings.py segmentation.py audio_io.py timing.py bench.py ./
COPY static ./static
COPY conversion/validate.py ./conversion/validate.py
COPY scripts/fetch_rknn_runtime.py scripts/download_models.py ./scripts/
COPY --chmod=755 docker/rknn-entrypoint.sh ./docker/rknn-entrypoint.sh
COPY rknn_models ./rknn_models

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/api/v1/ready')"
ENTRYPOINT ["/app/docker/rknn-entrypoint.sh"]
CMD ["python", "app.py"]
