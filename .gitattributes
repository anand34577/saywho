# LF everywhere (shell scripts break with CRLF); Windows scripts keep CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.wav binary
*.flac binary
*.png binary
*.mp4 binary
*.npy binary
*.so binary
*.rknn binary
Dockerfile.rknn -binary text diff merge eol=lf
*.onnx binary
